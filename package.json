{
  "name": "wastewater-quality-assessment",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install-all": "npm install && cd client && npm install && cd ../server && npm install",
    "dev": "concurrently \"npm run dev --workspace=client\" \"npm run dev --workspace=server\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
